datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
}

// ------------------------------------------------------
// USER & AUTHENTICATION
// ------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  avatarUrl    String   @map("avatar_url")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  userRoles UserRole[]
  session   UserSession?
  auditLogs AuditLog[]

  @@map("users")
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  token     String   @unique @db.VarChar(500) // Access or Refresh Token reference
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

// ------------------------------------------------------
// ROLES & PERMISSIONS SYSTEM (RBAC)
// ------------------------------------------------------

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., "SUPER_ADMIN", "ADMIN", "USER"
  description String?
  isSystem    Boolean  @default(false) @map("is_system") // System roles that cannot be deleted
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  action      String   @unique // Key string, e.g., "users:create", "system:audit:read"
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

// Join Table: Users <-> Roles
model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// Join Table: Roles <-> Permissions
model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ------------------------------------------------------
// BRAND & DIRECTORY ASSET MANAGEMENT
// ------------------------------------------------------

model Brand {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  folders Folder[]
  images  Image[]

  @@map("brands")
}

model Folder {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  brandId     String   @map("brand_id")
  parentId    String?  @map("parent_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relaciones
  brand    Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  parent   Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderHierarchy")
  images   Image[]

  // Evita duplicar nombres de carpetas en un mismo nivel dentro de una marca
  @@unique([name, brandId, parentId])
  @@map("folders")
}

model Image {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  url         String   @db.VarChar(2048)
  sku         String?  @db.VarChar(100)
  brandId     String   @map("brand_id")
  folderId    String?  @map("folder_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relaciones
  brand  Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  folder Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([sku])
  @@index([brandId])
  @@index([folderId])
  @@map("images")
}

// ------------------------------------------------------
// AUDIT SYSTEM
// ------------------------------------------------------

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?     @map("user_id")
  action     AuditAction
  resource   String // Affected module or entity e.g., "auth", "user"
  resourceId String?     @map("resource_id")
  details    Json? // Metadata: IP, User-Agent, Changes Diffs, etc.
  createdAt  DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
